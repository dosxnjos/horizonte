[Variables]
; Modelo do Local.inc: copie para Local.inc (mesma pasta) e ajuste. O Local.inc não é versionado.
; Salve em UTF-16 LE com BOM. Qualquer variável do Variaveis.inc ou do Settings.inc pode ser
; sobrescrita aqui: o Local.inc é lido por último. Quem instala pelo .rmskin usa só o Settings.inc.

; Língua e dados reais (o Settings.inc versionado vem em inglês e em modo demo)
Idioma=pt
Demo=0

; Apelidos das contas Claude (o número é a posição da conta no snapshot do tray)
ApelidoConta1=pessoal
ApelidoConta2=trabalho

; Onde está o executável do claude-usage-tray (padrão no Variaveis.inc). Prefira variável de ambiente.
; TrayExe=%LOCALAPPDATA%\Programs\claude-usage-tray\Claude Usage Tray.exe

; Exemplos de sobrescrita
; Animacoes=0
; DebugLog=1
